// ForgeEngine.fgd
// TrenchBroom entity definitions for ForgeEngine
//
// Place this file at:   <TrenchBroom install>/games/ForgeEngine/ForgeEngine.fgd
// alongside:            <TrenchBroom install>/games/ForgeEngine/GameConfig.cfg
//
// Reload TrenchBroom after editing this file to see changes in the editor.
//
// Key syntax:
//   key(type) : "Description" : default
//   Numeric defaults are bare numbers; string defaults are quoted.
//   choices blocks use = after the option list opens.

// ─────────────────────────────────────────────────────────────────────────────
// Player
// ─────────────────────────────────────────────────────────────────────────────

@PointClass color(0 200 100) = info_player_start : "Player spawn point.
One per map. The player character is placed here at level load.
Angle = initial facing direction (0=+Z, 90=+X, 180=-Z, 270=-X)."
[
  angle(integer) : "Initial facing (degrees)" : 180
]

// ─────────────────────────────────────────────────────────────────────────────
// Enemies
// ─────────────────────────────────────────────────────────────────────────────

@PointClass color(220 60 60) = enemy_spawn : "Enemy spawn point.
The enemy type and patrol group are configurable per-spawn.
Patrol waypoints with a matching patrol_group key will be assigned to this enemy.
Optional weapon: set weaponId to equip on spawn; dropWeapon to leave a pickup on death."
[
  enemy_type(choices) : "Enemy type" : 0 =
  [
    0 : "Grunt (default)"
    1 : "Elite"
    2 : "Boss"
  ]
  patrol_group(string) : "Patrol group name — must match patrol_waypoint entities in this area" : ""
  aggro_radius(float) : "Detection radius in meters (overrides default)" : 0
  weaponId(string)    : "WeaponDef ID to equip on spawn (leave blank for unarmed)" : ""
  dropWeapon(choices) : "Drop equipped weapon as pickup on death" : 1 =
  [
    0 : "No"
    1 : "Yes (default)"
  ]
  dropId(string)      : "If dropWeapon is NO, set dropId to set specific weapon drop. Otherwise leave null." : "" 
]

// ─────────────────────────────────────────────────────────────────────────────
// Patrol
// ─────────────────────────────────────────────────────────────────────────────

@PointClass color(100 150 255) = patrol_waypoint : "Patrol path waypoint.
Enemies with a matching patrol_group key will walk between all waypoints in
their group in the order they appear in the .map file."
[
  patrol_group(string) : "Must match the patrol_group on the owning enemy_spawn" : ""
]

// ─────────────────────────────────────────────────────────────────────────────
// Triggers and flags
// ─────────────────────────────────────────────────────────────────────────────

@PointClass color(255 200 0) = flag_trigger : "Sets or clears a FlagManager flag when the
player enters the trigger radius. Used to drive quest state transitions."
[
  flag_id(integer)     : "Flag ID to set (see GameFlags.h)" : 0
  radius(float)        : "Trigger radius in meters" : 2.0
  trigger_once(integer): "0 = repeatable, 1 = fires once then deactivates" : 1
  set_value(integer)   : "Value to write: 0 = clear flag, 1 = set flag" : 1
]

// ─────────────────────────────────────────────────────────────────────────────
// Fog gate — boss entrance
// ─────────────────────────────────────────────────────────────────────────────

@PointClass color(100 200 255) = fog_gate : "Fog gate — blocks passage until requiredFlag is set.
Player is pushed back with a locked feedback if the flag is not set.
Orient with 'angle' so the gate face points toward the approach direction."
[
  requiredFlag(integer) : "FlagManager flag ID that must be set to pass (0 = always open)" : 0
  width(float)          : "Gate opening width in metres" : 2.0
  height(float)         : "Gate opening height in metres" : 3.0
  angle(integer)        : "Facing direction (0=+Z, 90=+X, 180=-Z, 270=-X)" : 0
]

// ─────────────────────────────────────────────────────────────────────────────
// Weapon pickup
// ─────────────────────────────────────────────────────────────────────────────

@PointClass color(255 220 50) = weapon_pickup : "Weapon lying on the ground.
Press E while inside the trigger radius to pick up.
Use respawns=1 for rare weapons that should not be permanently collected."
[
  weaponId(string)    : "WeaponDef ID — must match an entry in assets/data/weapons.json" : ""
  radius(float)       : "Pickup trigger radius in metres" : 1.0
  respawns(choices)   : "Respawns at bonfire rest?" : 0 =
  [
    0 : "No — permanent collect (default)"
    1 : "Yes — respawns on rest"
  ]
]

// ─────────────────────────────────────────────────────────────────────────────
// Bonfire / checkpoint
// ─────────────────────────────────────────────────────────────────────────────

@PointClass color(255 140 0) = bonfire : "Rest point / checkpoint.
The player can interact with this to save progress and reset enemies.
Fires RestEvent through EventBus and calls onBonfireRest Lua callback."
[
  bonfire_id(integer) : "Unique ID — used to distinguish multiple bonfires" : 0
  targetFlag(integer) : "FlagManager flag ID set when player rests here (0 = none)" : 0
  radius(float)       : "Trigger radius in meters" : 1.5
]

// ─────────────────────────────────────────────────────────────────────────────
// Lights (data only — no runtime renderer yet; placed for future use)
// ─────────────────────────────────────────────────────────────────────────────

@PointClass color(255 255 100) iconsprite("sprites/light.spr") = light_point :
"Point light source. Radius and colour recorded for future Phase 15 lighting pass."
[
  radius(float) : "Light radius in meters" : 5.0
  r(integer)    : "Red channel 0-255" : 255
  g(integer)    : "Green channel 0-255" : 230
  b(integer)    : "Blue channel 0-255" : 180
  intensity(float) : "Brightness multiplier" : 1.0
]

// ------------
// Brush Entities
// -----------

@SolidClass = func_wall : "Static collision geometry. Identical to worldspawn but can be grouped." []

@SolidClass = func_illusionary : "Visible geometry with NO collision." []

@SolidClass color(255 100 0) = trigger_once : "Invisible trigger volume defined by brush shape. Fires its target once
when entered"
[
  target(string) : "Entity targetname to activate" : ""
]

@SolidClass color(255 100 0) = trigger_multiple : "Invisible trigger volume defined by brush shape. Fires its target
each time the player enters"
[
  target(string) : "Entity targetname to activate" : ""
]
